# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Identity
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Blockchain (Polygon via Alchemy) — optional, stamps work without it
ALCHEMY_API_KEY=your-alchemy-api-key
POLYGON_WALLET_PRIVATE_KEY=0x...your-wallet-private-key

# App
NEXT_PUBLIC_APP_URL=https://your-app.onrender.com

# Notary Signing Secret — keep this secret, never commit it
GENID_SIGNING_SECRET=your-random-32-char-secret-here
