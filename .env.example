# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Identity
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Blockchain (Polygon via Alchemy) — optional, stamps work without it
ALCHEMY_API_KEY=your-alchemy-api-key
POLYGON_WALLET_PRIVATE_KEY=0x...your-wallet-private-key

# App
NEXT_PUBLIC_APP_URL=https://your-app.onrender.com

# Notary Signing Secret — keep this secret, never commit it
GENID_SIGNING_SECRET=your-random-32-char-secret-here

# OpenAI (Phase 1 Model Adapter — session generation)
OPENAI_API_KEY=sk-...

# C2PA signing credential (Phase 6) — a real, valid, non-self-signed X.509
# chain + private key (PEM). NOT issued through the official C2PA
# Conformance Program, so manifests signed with it read as structurally
# valid but report signingCredential.untrusted in any third-party
# verifier — see lib/c2pa.ts for the full explanation. Store multi-line PEM
# values as single env var strings with literal \n or via your host's
# multi-line env var support (Render supports pasting multi-line values
# directly). Generate your own chain — do not reuse a shared/example one:
#   openssl ecparam -genkey -name prime256v1 -noout -out root_key.pem
#   openssl req -new -x509 -key root_key.pem -out root_cert.pem -days 3650 \
#     -subj "/CN=Your Dev Root CA/O=YourOrg/C=US" \
#     -addext "basicConstraints=critical,CA:true" \
#     -addext "keyUsage=critical,keyCertSign,cRLSign"
#   openssl ecparam -genkey -name prime256v1 -noout -out leaf_key.pem
#   openssl req -new -key leaf_key.pem -out leaf.csr -subj "/CN=Your Dev Signer/O=YourOrg/C=US"
#   openssl x509 -req -in leaf.csr -CA root_cert.pem -CAkey root_key.pem -CAcreateserial \
#     -out leaf_cert.pem -days 1825 -extfile <(printf "basicConstraints=critical,CA:false\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=emailProtection\n")
#   openssl pkcs8 -topk8 -nocrypt -in leaf_key.pem -out leaf_key_pkcs8.pem
#   cat leaf_cert.pem root_cert.pem > cert_chain.pem
C2PA_SIGNING_CERT_CHAIN_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
C2PA_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
